{
  "name": "OwnItSooner",
  "version": "1.0.2",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "whoami": "dotenv -e .env.expo -- eas whoami",
    "build:ios": "dotenv -e .env.expo -- eas build -p ios",
    "build:android": "dotenv -e .env.expo -- eas build -p android",
    "submit:ios": "dotenv -e .env.expo -- eas submit -p ios",
    "submit:android": "dotenv -e .env.expo -- eas submit -p android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "eas-cli": "^16.17.0",
    "expo": "~54.0.0",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-google-mobile-ads": "^15.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "dotenv-cli": "^10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
